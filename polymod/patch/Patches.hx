package polymod.patch;

import polymod.Polymod;
import polymod.patch.PatchSlot.PatchEntry;
import polymod.patch.PatchSlot.PatchOptions;

/**
 * A static class that manages every patch applied to the game.
 * These are like mixins or harmony patches.
 */
class Patches
{
  /**
   * Prefix of the generated static holding a function's `PatchSlot`.
   */
  public static final SLOT_PREFIX:String = '__patch_';

  /**
   * Prefix of the generated function holding a function's original body.
   */
  public static final ORIG_PREFIX:String = '__orig_';

  static final active:Array<PatchSlot> = [];
  static var loadOrder:Map<String, Int> = new Map<String, Int>();

  /**
   * Set the load order of mods, so patches can be sorted by which mod they came from.
   */
  public static function setLoadOrder(modIds:Array<String>):Void
  {
    loadOrder = new Map<String, Int>();
    for (i in 0...modIds.length)
      loadOrder.set(modIds[i], i);
  }

  public static function loadOrderOf(owner:String):Int
  {
    var order:Null<Int> = loadOrder.get(owner);
    return order == null ? 0x3FFFFFFF : order;
  }

  /**
   * Run a callback before the original function. `state.skip` can be set to skip the original and go straight to the postfixes.
   * @return Whether the patch was applied.
   */
  public static function prefix(className:String, field:String, fn:PatchState->Void, owner:String, ?options:PatchOptions):Bool
  {
    return add(className, field, fn, owner, options, true);
  }

  /**
   * Run a callback after the original function. `state.result` can be set to change the return value.
   * @return Whether the patch was applied.
   */
  public static function postfix(className:String, field:String, fn:PatchState->Void, owner:String, ?options:PatchOptions):Bool
  {
    return add(className, field, fn, owner, options, false);
  }

  /**
   * Remove every patch a mod added.
   */
  public static function unpatchAll(owner:String):Void
  {
    var i:Int = active.length;
    while (i-- > 0)
    {
      var slot:PatchSlot = active[i];
      if (!slot.removeOwner(owner) || !slot.isEmpty()) continue;
      detach(slot);
      active.splice(i, 1);
    }
  }

  /**
   * Remove every patch.
   */
  public static function clear():Void
  {
    for (slot in active)
      detach(slot);
    active.resize(0);
  }

  /**
   * Every patch on a function, in run order.
   */
  public static function list(className:String, field:String):{prefixes:Array<PatchEntry>, postfixes:Array<PatchEntry>}
  {
    for (slot in active)
    {
      if (slot.className != className || slot.field != field) continue;
      return {prefixes: slot.prefixes.copy(), postfixes: slot.postfixes.copy()};
    }
    return {prefixes: [], postfixes: []};
  }

  /**
  * Whether a field name is a patch hook or original function generated by the patch macro.
   */
  public static inline function isHiddenField(name:String):Bool
  {
    return name.charCodeAt(0) == '_'.code && name.charCodeAt(1) == '_'.code
      && (StringTools.startsWith(name, SLOT_PREFIX) || StringTools.startsWith(name, ORIG_PREFIX));
  }

  /**
   * Register every patch scripts declared with metadata.
   */
  @:noCompletion
  public static function registerDeclared():Void
  {
    @:privateAccess
    for (clsName => decl in polymod.hscript._internal.Interp._scriptClassDescriptors)
    {
      if (decl.meta == null || decl.meta.length == 0) continue;

      var targets:Array<Array<Dynamic>> = [];
      var options:PatchOptions = {};
      for (m in decl.meta)
      {
        var values:Array<Dynamic> = [for (p in m.params ?? []) constOf(p)];
        switch (m.name)
        {
          case 'patch' | ':patch':
            targets.push(values);
          case 'patchPriority' | ':patchPriority':
            options.priority = Std.int(values[0] ?? 0);
          case 'patchBefore' | ':patchBefore':
            options.before = [for (v in values) Std.string(v)];
          case 'patchAfter' | ':patchAfter':
            options.after = [for (v in values) Std.string(v)];
          default:
        }
      }
      if (targets.length == 0) continue;

      var owner:String = ownerOfOrigin(polymod.hscript._internal.Interp.scriptClassOrigins.get(clsName), clsName);
      var hasPrefix:Bool = polymod.hscript._internal.PolymodScriptClass.hasScriptClassStaticFunction(clsName, 'prefix');
      var hasPostfix:Bool = polymod.hscript._internal.PolymodScriptClass.hasScriptClassStaticFunction(clsName, 'postfix');
      registerTargets(clsName, owner, targets, options, hasPrefix ? scriptCallback(clsName, 'prefix') : null,
        hasPostfix ? scriptCallback(clsName, 'postfix') : null);
    }

    #if (hxcpp && POLYMOD_CPPIA)
    for (clsName in polymod.hscript._internal.PolymodCppiaClassReference.listCppiaClasses())
    {
      var cls:Null<Class<Dynamic>> = polymod.hscript._internal.PolymodCppiaClassReference.getCppiaClass(clsName);
      if (cls == null) continue;

      var meta:Dynamic = haxe.rtti.Meta.getType(cls);
      if (meta == null) continue;

      var patchMeta:Null<Array<Dynamic>> = Reflect.field(meta, 'patch');
      if (patchMeta == null) continue;

      var targets:Array<Array<Dynamic>> = [];

      // One @patch gives its argument list, several give one list each.
      if (patchMeta.length > 0 && Std.isOfType(patchMeta[0], String)) targets.push(patchMeta);
      else for (t in patchMeta) targets.push(cast t);

      var options:PatchOptions = {};
      var priority:Null<Array<Dynamic>> = Reflect.field(meta, 'patchPriority');
      if (priority != null && priority.length > 0) options.priority = Std.int(priority[0]);
      var before:Null<Array<Dynamic>> = Reflect.field(meta, 'patchBefore');
      if (before != null) options.before = [for (v in before) Std.string(v)];
      var after:Null<Array<Dynamic>> = Reflect.field(meta, 'patchAfter');
      if (after != null) options.after = [for (v in after) Std.string(v)];

      var path:Null<String> = polymod.hscript._internal.PolymodCppiaClassReference.pathOfCppiaClass(clsName);
      var owner:String = ownerOfPath(path, clsName);
      var prefixRef:Dynamic = Reflect.field(cls, 'prefix');
      var postfixRef:Dynamic = Reflect.field(cls, 'postfix');

      registerTargets(clsName, owner, targets, options, prefixRef == null ? null : cast prefixRef, postfixRef == null ? null : cast postfixRef);
    }
    #end
  }

  static function scriptCallback(clsName:String, funcName:String):PatchState->Void
  {
    return function(state:PatchState):Void {
      polymod.hscript._internal.PolymodScriptClass.callScriptClassStaticFunction(clsName, funcName, [state], true);
    };
  }

  static function registerTargets(clsName:String, owner:String, targets:Array<Array<Dynamic>>, options:PatchOptions, prefixFn:Null<PatchState->Void>,
      postfixFn:Null<PatchState->Void>):Void
  {
    if (prefixFn == null && postfixFn == null)
    {
      Polymod.error(SCRIPT_PATCH, 'Class $clsName declares @patch but has no static prefix or postfix function.', SCRIPT_RUNTIME);
      return;
    }

    for (target in targets)
    {
      if (target.length < 2 || target[0] == null || target[1] == null)
      {
        Polymod.error(SCRIPT_PATCH, 'Class $clsName has a @patch without a class name and function name.', SCRIPT_RUNTIME);
        continue;
      }

      var targetClass:String = Std.string(target[0]);
      var targetField:String = Std.string(target[1]);
      if (prefixFn != null) prefix(targetClass, targetField, prefixFn, owner, options);
      if (postfixFn != null) postfix(targetClass, targetField, postfixFn, owner, options);
    }
  }

  static function ownerOfOrigin(origin:Null<String>, fallback:String):String
  {
    // Origins look like `hscriptClass(path)`.
    if (origin != null)
    {
      var open:Int = origin.indexOf('(');
      if (open >= 0 && StringTools.endsWith(origin, ')')) origin = origin.substring(open + 1, origin.length - 1);
    }
    return ownerOfPath(origin, fallback);
  }

  @:access(polymod.Polymod.assetLibrary)
  static function ownerOfPath(path:Null<String>, fallback:String):String
  {
    if (path == null || Polymod.assetLibrary == null) return fallback;
    return Polymod.assetLibrary.modIdOf(path) ?? fallback;
  }

  static function constOf(e:polymod.hscript._internal.Expr):Dynamic
  {
    #if hscriptPos
    var def:polymod.hscript._internal.Expr.ExprDef = e.e;
    #else
    var def:polymod.hscript._internal.Expr = e;
    #end
    return switch (def)
    {
      case EConst(CString(s, _)): s;
      case EConst(CInt(v)): v;
      case EConst(CFloat(f)): f;
      case EUnop('-', true, inner): -constOf(inner);
      default: null;
    }
  }

  /**
   * Run a callback before or after the original function. The callback can skip the original and change the return value.
   */
  @:noCompletion
  public static function run(slot:PatchSlot, instance:Dynamic, args:Array<Dynamic>):Dynamic
  {
    var state:PatchState = new PatchState(slot, instance, args);

    for (entry in slot.prefixes)
      invoke(slot, entry, state, 'prefix');

    state.owner = null;

    if (!state.skip)
    {
      state.result = callOriginal(slot, instance, state.args);
      state.ranOriginal = true;
    }

    for (entry in slot.postfixes)
      invoke(slot, entry, state, 'postfix');

    return state.result;
  }

  static inline function invoke(slot:PatchSlot, entry:PatchEntry, state:PatchState, kind:String):Void
  {
    if (entry.enabled)
    {
      state.owner = entry.owner;
      try
      {
        entry.fn(state);
      }
      catch (e:Dynamic)
      {
        entry.enabled = false;
        Polymod.error(SCRIPT_PATCH,
          'The $kind from mod "${entry.owner}" on ${slot.className}.${slot.field} threw an error and was disabled until mods are reloaded:\n${describeError(e)}',
          SCRIPT_RUNTIME);
      }
    }
  }

  static function describeError(e:Dynamic):String
  {
    if (Std.isOfType(e, haxe.ValueException)) e = cast(e, haxe.ValueException).value;
    #if hscriptPos
    if (Std.isOfType(e, polymod.hscript._internal.Expr.Error))
    {
      var err:polymod.hscript._internal.Expr.Error = cast e;
      return 'Line ${err.line}: ' + polymod.hscript._internal.Printer.errorToString(err, false);
    }
    #end
    return Std.string(e);
  }

  static function callOriginal(slot:PatchSlot, instance:Dynamic, args:Array<Dynamic>):Dynamic
  {
    if (slot.isStatic)
    {
      if (slot.staticOrig == null) slot.staticOrig = Reflect.field(slot.cls, slot.origName);
      return Reflect.callMethod(slot.cls, slot.staticOrig, args);
    }

    return Reflect.callMethod(instance, Reflect.field(instance, slot.origName), args);
  }

  static function add(className:String, field:String, fn:PatchState->Void, owner:String, options:Null<PatchOptions>, isPrefix:Bool):Bool
  {
    if (fn == null)
    {
      Polymod.error(SCRIPT_PATCH, 'Mod "$owner" tried to patch $className.$field with no function.', SCRIPT_RUNTIME);
      return false;
    }

    var slot:Null<PatchSlot> = findSlot(className, field, owner);
    if (slot == null) return false;

    slot.add(new PatchEntry(owner, fn, options), isPrefix);
    return true;
  }

  static function findSlot(className:String, field:String, owner:String):Null<PatchSlot>
  {
    for (slot in active)
      if (slot.className == className && slot.field == field) return slot;

    var cls:Null<Class<Dynamic>> = Type.resolveClass(className);
    if (cls == null)
    {
      Polymod.error(SCRIPT_PATCH, 'Mod "$owner" tried to patch $className.$field, but there is no native class named $className.', SCRIPT_RUNTIME);
      return null;
    }

    var slotName:String = SLOT_PREFIX + field;

    // The function may be declared on a superclass. Patching it there affects every subclass that doesn't override it.
    var declaring:Null<Class<Dynamic>> = cls;
    while (declaring != null && !Type.getClassFields(declaring).contains(slotName))
      declaring = Type.getSuperClass(declaring);

    if (declaring == null)
    {
      if (isBlacklisted(className))
      {
        Polymod.error(SCRIPT_PATCH, 'Mod "$owner" tried to patch $className.$field, which is a blacklisted class.', SCRIPT_RUNTIME);
      }
      else
      {
        Polymod.error(SCRIPT_PATCH,
          'Mod "$owner" tried to patch $className.$field, which can\'t be patched. It may not exist, be inline, or be in a package the game doesn\'t allow patching.',
          SCRIPT_RUNTIME);
      }
      return null;
    }

    var declaringName:String = Type.getClassName(declaring);

    // Patching through a subclass lands on the declaring class, so look again under that name.
    if (declaringName != className)
    {
      for (slot in active)
        if (slot.className == declaringName && slot.field == field) return slot;
    }

    var origName:String = ORIG_PREFIX + declaringName.split('.').join('_') + '_' + field;
    var isStatic:Bool = Type.getClassFields(declaring).contains(origName);

    var slot:PatchSlot = new PatchSlot(declaring, declaringName, field, slotName, origName, isStatic);
    Reflect.setField(declaring, slotName, slot);
    active.push(slot);
    return slot;
  }

  static final excludedPackages:Array<String> = [
    for (part in (haxe.macro.Compiler.getDefine('POLYMOD_PATCH_EXCLUDE') ?? '').split(','))
      if (StringTools.trim(part).length > 0) StringTools.trim(part)
  ];

  static function isBlacklisted(className:String):Bool
  {
    for (pack in excludedPackages)
      if (className == pack || StringTools.startsWith(className, pack + '.')) return true;
    return false;
  }

  static function detach(slot:PatchSlot):Void
  {
    Reflect.setField(slot.cls, slot.slotName, null);
  }
}
