package tests;
import tests.Stage;

class BasicStage extends Stage {
  public function new(stageId:String) {
    super(stageId);
    name = "scripted";
  }

  public override function update(amount:Int):Int {
    super.update(amount);
    return count * 2;
  }

  public function addScriptOnly(amount:Int):Int {
    scriptValue += amount;
    return scriptValue;
  }

  public function testUsingExtensions():String {
    var array:Array<String> = [];
    var map:Map<String, String> = [];

    array.append(["first"]);
    map.append(["map" => "value"]);
    array.append(["second"]);
    map.append(["again" => "more"]);

    return '${array[0]},${array[1]}:${map["map"]}:${map["again"]}';
  }

  public static function addStatic(amount:Int):Int {
    return 40 + amount;
  }

  static var staticValue:Int = 10;
  var scriptValue:Int = 5;
}
