package tests;

import tests.ScriptedStage;

class BasicStage extends ScriptedStage {
  public function new(id:String) {
    super(id);
    name = "scripted";
  }

  public var scriptValue:Int = 5;

  public override function update(amount:Int):Int {
    super.update(amount);
    return count * 2;
  }

  public function addScriptOnly(amount:Int):Int {
    return scriptValue + amount;
  }

  public static var staticValue:Int = 10;

  public static function addStatic(amount:Int):Int {
    return amount + 40;
  }
}
