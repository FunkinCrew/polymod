var total = 0;
for (value in [0, 1, 2, 3, 4]) {
  if (value % 2 == 0) total += value;
}

var remaining = 2;
while (remaining > 0) {
  total += remaining;
  remaining--;
}

var multiplier = 0;
switch (total) {
  case 9: multiplier = 2;
  default: multiplier = 0;
}

var result = total * multiplier;
result
